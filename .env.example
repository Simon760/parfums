# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : uniquement pour `npm run seed` en local. Ne pas mettre sur Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Email(s) autorisé(s) à se connecter, séparés par des virgules
ALLOWED_EMAIL=simon@example.com

# console.anthropic.com > API Keys
ANTHROPIC_API_KEY=
